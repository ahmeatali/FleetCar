{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests vite.config.js package.json eslint.config.js",
    "format:check": "prettier --check src tests vite.config.js package.json eslint.config.js",
    "lint": "eslint src tests vite.config.js eslint.config.js",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.1.1"
  }
}
